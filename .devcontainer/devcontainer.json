{
    "name": "cpp-devcontainer",
    "image": "mcr.microsoft.com/devcontainers/cpp:trixie",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true,
            "installZsh": "true",
            "installOhMyZsh": "true",
            "installOhMyZshConfig": "true"
        },
        "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
            "packages": "curl,wget,git,ca-certificates,build-essential,clangd,clang-format,clang-tidy"
        }
    },
    "runArgs": [ "--init", "--rm" ],
    "containerUser": "vscode",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "settings": {
                // Util
                "editor.tabSize": 4,
                "editor.formatOnSave": false,
                "debug.inlineValues": "auto",
                "zenMode.hideLineNumbers": false,
                "git-graph.dialog.merge.noFastForward": false,
                "git-graph.dialog.rebase.launchInteractiveRebase": false,
                "git-graph.dialog.rebase.ignoreDate": false,
                "git-graph.repository.fetchAndPrune": true,
                "files.eol": "\n",
                // C++
                "[cpp]": {
                    "editor.tabSize": 2,
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },
                "C/C++ Include Guard.Macro Type": "Filename and GUID",
                // Cmake
                "[cmake]": {
                    "editor.formatOnSave": false
                },
                "cmake.parallelJobs": 0,
                // Json
                "[json][jsonc]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "prettier.tabWidth": 4
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "akiramiyakoda.cppincludeguard",
                "vadimcn.vscode-lldb",
                "ms-vscode.cmake-tools",
                "mhutchie.git-graph",
                "esbenp.prettier-vscode",
                "-ms-vscode.cpptools"
            ]
        }
    }
}
